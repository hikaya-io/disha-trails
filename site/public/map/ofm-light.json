      "type": "raster-dem",
      "tiles": [
        "disha://terrain/{z}/{x}/{y}"
      ],
      "tileSize": 512,
      "encoding": "terrarium",
      "minzoom": 10,
      "maxzoom": 12
    },
    "contour": {
      "type": "vector",
      "tiles": [
        "disha://contours/{z}/{x}/{y}"
      ],
      "minzoom": 11,
      "maxzoom": 14
    }
