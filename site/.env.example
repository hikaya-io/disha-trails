# Canonical address of the site, with any base path and no trailing slash. Required for production builds:
# canonicals, Open Graph URLs, the sitemap and JSON-LD all read it.
NEXT_PUBLIC_SITE_URL=https://disha.hikaya.io

# The waitlist posts to the hikaya-contact-form Worker (website-2.0). Same values as website-2.0.
NEXT_PUBLIC_CONTACT_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. The path the site is served under, no trailing slash: /disha-trails on
# hikaya-io.github.io, empty at a domain root. The deploy workflow sets it from NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_BASE_PATH=

# Optional. Where /maps/ and /trails/ read coverage.json, at build time and in the browser.
# Defaults to the site's own /coverage.json, which the deploy copies from the coverage-data branch;
# locally, download it into public/ (gitignored, see the README). Set the live URL,
# https://hikaya-io.github.io/disha-trails/coverage.json, to skip the download, or a local copy
# such as /coverage-local.json in public/ (gitignored) to preview other data.
NEXT_PUBLIC_COVERAGE_DATA_URL=
# Optional. The tile service the maps read (cells and the world map). Defaults to
# https://tiles.hikaya.app. NEXT_PUBLIC_DISHA_WORLD_URL overrides just the world map's folder
# (the one holding world-base, world-relief and world-routes .pmtiles).
NEXT_PUBLIC_DISHA_TILES_URL=
NEXT_PUBLIC_DISHA_WORLD_URL=
