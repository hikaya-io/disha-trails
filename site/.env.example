# Canonical origin of the site, no trailing slash. Required for production builds:
# canonicals, Open Graph URLs, the sitemap and JSON-LD all read it.
NEXT_PUBLIC_SITE_URL=https://disha.hikaya.io

# The waitlist posts to the hikaya-contact-form Worker (website-2.0). Same values as website-2.0.
NEXT_PUBLIC_CONTACT_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. Where /coverage/ and /trails/ fetch coverage.json. Defaults to the copy disha-tiles
# publishes daily on GitHub Pages. Set it to preview a local copy, such as /coverage-local.json
# in public/ (gitignored).
NEXT_PUBLIC_COVERAGE_DATA_URL=
# Optional. The tile service the maps read (cells and the world map). Defaults to
# https://tiles.hikaya.app. NEXT_PUBLIC_DISHA_WORLD_URL overrides just the world map's folder
# (the one holding world-base, world-relief and world-routes .pmtiles).
NEXT_PUBLIC_DISHA_TILES_URL=
NEXT_PUBLIC_DISHA_WORLD_URL=
